# HTTP
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=15s

# Postgres
DATABASE_URL=postgres://cstati:cstati@localhost:5432/cstatiwarehouse?sslmode=disable

# JWT. Сгенерировать: openssl rand -hex 32
JWT_SECRET=change-me-please-32-bytes-or-more-64-hex-chars-is-perfect
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Telegram Login. Оставить пустыми, чтобы эндпоинт /auth/telegram возвращал 503.
TELEGRAM_CLIENT_ID=
TELEGRAM_ISSUER=https://oauth.telegram.org
TELEGRAM_JWKS_URL=https://oauth.telegram.org/.well-known/jwks.json
