# Для доступа с iPhone по Wi‑Fi: достаточно «все интерфейсы» — :8080 (dual-stack IPv4/IPv6 в Go).
# Явный 0.0.0.0:8080 при старте сервера приводится к :8080 для совместимости со стеком iOS.
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=15s

# Для docker compose: публичный URL API как с телефона (LAN Mac). Не коммить секреты.
# PUBLIC_BASE_URL=http://192.168.1.68:8080

# Postgres
# В проде укажите sslmode и CA (например ?sslmode=verify-full) — не оставляйте sslmode=disable.
DATABASE_URL=postgres://cstati:cstati@localhost:5432/cstatiwarehouse?sslmode=disable

# JWT. Сгенерировать: openssl rand -hex 32
JWT_SECRET=change-me-please-32-bytes-or-more-64-hex-chars-is-perfect
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Telegram Login. Оставить пустыми, чтобы эндпоинт /auth/telegram возвращал 503.
TELEGRAM_CLIENT_ID=
TELEGRAM_ISSUER=https://oauth.telegram.org
TELEGRAM_JWKS_URL=https://oauth.telegram.org/.well-known/jwks.json

# Google Sign-In (aud в id_token = iOS OAuth client id). Пусто → 503 на POST /auth/google.
GOOGLE_CLIENT_ID=

# В проде: DATABASE_REQUIRE_TLS=1 и строка без sslmode=disable.
# DATABASE_REQUIRE_TLS=false

# Подпись URL для GET /uploads/{file}?token=… По умолчанию используется тот же секрет, что и JWT; в проде лучше отдельный `openssl rand -hex 32`.
# UPLOAD_SIGNING_SECRET=
UPLOAD_URL_TTL=168h

# За reverse-proxy (nginx / load balancer): CIDR доверенных узлов; тогда для rate limit берётся первый IP из X-Forwarded-For. Пусто — только TCP RemoteAddr.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,10.0.0.0/8
